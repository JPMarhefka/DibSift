{
  "manifest_version": 3,
  "name": "DibSift - Facebook Deal Finder",
  "version": "1.0.2",
  "description": "Save, compare, and analyze visible Facebook Marketplace listings with Gemini-assisted shopping decisions.",
  "icons": {
    "16": "icons/Dibsift-Icon-16.png",
    "32": "icons/Dibsift-Icon-32.png",
    "48": "icons/Dibsift-Icon-48.png",
    "96": "icons/Dibsift-Icon-96.png",
    "128": "icons/Dibsift-Icon-128.png"
  },
  "permissions": ["storage", "downloads", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data:; connect-src https://generativelanguage.googleapis.com"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DibSift",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/Dibsift-Icon-16.png",
      "32": "icons/Dibsift-Icon-32.png",
      "48": "icons/Dibsift-Icon-48.png",
      "96": "icons/Dibsift-Icon-96.png"
    }
  },
  "commands": {
    "save-current-listing": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save the currently visible Facebook Marketplace listing"
    },
    "remove-last-listing": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Remove the most recently saved Marketplace listing"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["listingParser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
